# Every variable Buildly reads (ARCHITECTURE.md §9). Placeholders only; never commit
# real values. Which service receives which variable is in HOSTING.md §4, and
# loadConfig() in packages/shared validates them at startup.
# Values below are for local development with docker-compose (`pnpm services:up`: Postgres on
# 5433, the RustFS S3 server on 9000). The storage keys are the local server's, not AWS keys.

# --- web and worker ---
DATABASE_URL=postgres://buildly:buildly@localhost:5433/buildly
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=buildly-dev
STORAGE_ACCESS_KEY=buildly-dev
STORAGE_SECRET_KEY=buildly-dev-secret
# Empty for real AWS S3; the local S3 server's URL in development.
STORAGE_ENDPOINT=http://localhost:9000
APP_URL=http://localhost:3300
# Must equal sdkVersion in packages/foundation/foundation.json (SPIKES.md S2).
SNACK_SDK_VERSION=54.0.0
# Empty disables Sentry.
SENTRY_DSN=

# --- web only ---
# Buildly's build of the Snack web player (packages/web-player); %%SDK_VERSION%% becomes the
# SDK major. Empty uses Expo's hosted player, which works from localhost only.
SNACK_WEB_PLAYER_URL=
# `console` prints magic links to the web server's log instead of sending email.
EMAIL_PROVIDER_API_KEY=console
EMAIL_FROM=login@localhost
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# --- worker only (never set these on web) ---
OPENAI_API_KEY=replace-me
# Empty unless routing through a proxy or a test server.
OPENAI_BASE_URL=
GENERATION_MODEL_PLAN=gpt-6.1-sol
GENERATION_MODEL_EDIT=gpt-6-luna
