# Every variable Buildly reads (ARCHITECTURE.md §9). Placeholders only; never commit
# real values. Which service receives which variable is in HOSTING.md §4, and
# loadConfig() in packages/shared validates them at startup.
# Values below are for local development with docker-compose (Postgres + MinIO).

# --- web and worker ---
DATABASE_URL=postgres://buildly:buildly@localhost:5432/buildly
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=buildly-dev
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
# Empty for real AWS S3; the MinIO URL for local development.
STORAGE_ENDPOINT=http://localhost:9000
APP_URL=http://localhost:3000
# Must equal sdkVersion in packages/foundation/foundation.json (SPIKES.md S2).
SNACK_SDK_VERSION=54.0.0
# Empty disables Sentry.
SENTRY_DSN=

# --- web only ---
EMAIL_PROVIDER_API_KEY=replace-me
EMAIL_FROM=login@localhost
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# --- worker only (never set these on web) ---
OPENAI_API_KEY=replace-me
# Empty unless routing through a proxy or a test server.
OPENAI_BASE_URL=
GENERATION_MODEL_PLAN=gpt-6.1-sol
GENERATION_MODEL_EDIT=gpt-6-luna
