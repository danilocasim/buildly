{
  "name": "buildly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "check:secrets": "tsx scripts/check-no-secrets.ts",
    "checker:selftest": "pnpm --filter @buildly/checker selftest",
    "services:up": "sh scripts/services.sh up",
    "services:down": "sh scripts/services.sh down",
    "db:generate": "pnpm --filter @buildly/db generate",
    "db:migrate": "pnpm --filter @buildly/db migrate",
    "db:migrate:down": "pnpm --filter @buildly/db migrate:down",
    "db:seed": "pnpm --filter @buildly/db seed",
    "db:grant-credits": "pnpm --filter @buildly/db grant-credits",
    "test:snack": "SNACK_LIVE=1 pnpm --filter @buildly/snack exec vitest run src/snack.live.test.ts",
    "eval": "tsx --env-file-if-exists=.env packages/eval/src/cli.ts",
    "eval:report": "tsx packages/eval/src/report-cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0"
  }
}
